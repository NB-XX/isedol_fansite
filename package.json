{
  "name": "isedol_fansite",
  "version": "3.1.0",
  "description": "异世界女团粉丝站数据采集系统",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node start-all.js",
    "dev": "node start-all.js",
    "cafe": "node index.js cafe",
    "stream": "node index.js stream",
    "status": "node index.js status",
    "articles": "node index.js articles",
    "stats": "node index.js stats",
    "services": "node service-manager.js",
    "services:start": "node service-manager.js start",
    "services:stop": "node service-manager.js stop",
    "services:restart": "node service-manager.js restart",
    "services:status": "node service-manager.js status",
    "migrate": "node scripts/migrate-to-sqlite.js",
    "db:update": "node scripts/update-database-schema.js",
    "db:add-source": "node scripts/add-source-field.js",
    "translate": "node translate.js translate",
    "translate:test": "node translate.js test",
    "translate:stats": "node translate.js stats",
    "translate:retranslate": "node translate.js retranslate",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop isedol-fansite",
    "pm2:restart": "pm2 restart isedol-fansite",
    "pm2:reload": "pm2 reload isedol-fansite",
    "pm2:delete": "pm2 delete isedol-fansite",
    "pm2:logs": "pm2 logs isedol-fansite",
    "pm2:monit": "pm2 monit",
    "cf:migrate": "node scripts/migrate-to-d1.js",
    "cf:deploy": "wrangler deploy",
    "cf:deploy-all": "npm run cf:migrate && wrangler deploy && cd web && npm run build && wrangler pages deploy dist",
    "cf:tail": "wrangler tail",
    "cf:d1-query": "wrangler d1 execute isedol-fansite-db",
    "cf:check": "powershell -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "vps:start": "node vps-server.js",
    "vps:pm2": "pm2 start vps-server.js --name isedol-vps"
  },
  "keywords": [
    "isedol",
    "naver-cafe",
    "stream-monitor"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.4",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase": "^11.0.0",
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
