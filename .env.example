# Naver Cafe 配置
CAFE_ID=27842958
MENU_ID=345
SCRAPER_INTERVAL=600000

# 代理配置（可选）
USE_PROXY=false
PROXY_URL=http://127.0.0.1:7890

# Firebase 配置
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app/

# 数据库配置
DB_ARTICLES_FILE=./data/articles.json
DB_STREAMS_FILE=./data/streams.json

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 管理员密码（用于访问设置页面）
ADMIN_PASSWORD=your_admin_password

# AI 翻译配置
TRANSLATION_ENABLED=true
TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
TRANSLATION_API_KEY=your_api_key
TRANSLATION_MODEL=gpt-3.5-turbo
TRANSLATION_SYSTEM_PROMPT="你是一个专业的韩中翻译助手。请将用户提供的韩语文本翻译成简体中文。保持原文的语气和风格，确保翻译自然流畅。只返回翻译结果，不要添加任何解释或额外内容。고세구、아이네、징버거、주르르、릴파、비챤。这些是人名，保留不翻译。这些是你可能用得到的翻译词典：생방송（生放送）直播，常缩写为방송；뱅온 来自"방송 ON"（开播）；휴방/휴뱅 休播，即今天不播；기습 突击直播；합방 联动直播；노래방（KTV）歌回；다시보기 录播(回看)。如果是html代码，则只翻译文本区域，保留原始HTML代码。如果是json代码，则只翻译韩语文本字段，保留原始json结构。以下是你可能需要知道的知识：생방송（生放送）直播，常缩写为방송뱅온  来自"방송 ON"（开播）。휴방/휴뱅 休播，即今天不播。기습 突击直播합방 联动直播노래방（KTV）歌回"
TRANSLATION_TEMPERATURE=0.3
TRANSLATION_MAX_TOKENS=100000
TRANSLATION_TIMEOUT=60000

# 个性化配置
BACKGROUND_IMAGE=https://example.com/your-background.png
BACKGROUND_BLUR=5
MUSIC_PLAYLIST="[]"
